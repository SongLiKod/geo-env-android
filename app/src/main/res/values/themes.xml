<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GeoEnv" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/geoenv_background_light</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.GeoEnv.Slot" parent="Theme.GeoEnv">
        <item name="android:windowBackground">@color/geoenv_background_light</item>
    </style>

    <style name="Theme.GeoEnv.Splash" parent="Theme.GeoEnv">
        <item name="android:windowBackground">@color/geoenv_primary</item>
    </style>
</resources>
